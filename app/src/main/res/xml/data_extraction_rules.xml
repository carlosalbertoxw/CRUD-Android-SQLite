<?xml version="1.0" encoding="utf-8"?>
<!-- Qué se respalda en Android 12 (API 31) o superior: solo la base de notas,
     tanto en la copia en la nube como al pasar datos a un teléfono nuevo. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
